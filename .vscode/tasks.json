{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "CMake: configure",
            "command": "${config:cmake.cmakePath}",
            "args": ["-S", ".", "-B", "build", "-A", "x64"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            "type": "shell",
            "label": "CMake: build Debug",
            "command": "${config:cmake.cmakePath}",
            "args": ["--build", "build", "--config", "Debug", "--parallel"],
            "options": { "cwd": "${workspaceFolder}" },
            "dependsOn": "CMake: configure",
            "problemMatcher": ["$msCompile"],
            "group": { "kind": "build", "isDefault": true }
        },
        {
            "type": "shell",
            "label": "Stage 1: full acceptance",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                ".\\Tools\\RunStage1Acceptance.ps1"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        }
    ]
}
