{
  "status": "STATIC_LIBRARY_VALIDATED",
  "version": "1.0.0",
  "root": "Assets/_TA/Shaders/Library",
  "namespacePrefix": "TA_",
  "precisionPolicy": "Renderer-facing calculations use half precision unless Unity requires float inputs",
  "aggregate": {
    "file": "Assets/_TA/Shaders/Library/TA_ShaderLibrary.hlsl",
    "includeGuard": "TA_SHADER_LIBRARY_INCLUDED",
    "modules": ["types", "common", "brdf", "lighting", "debugViews"]
  },
  "consumer": {
    "file": "Assets/_TA/Shaders/TA_BasePassLightingDecomposition.shader",
    "include": "Library/TA_ShaderLibrary.hlsl",
    "entryPoints": ["TA_EvaluateLighting", "TA_SelectDebugView"]
  },
  "modules": [
    {
      "id": "types",
      "file": "Assets/_TA/Shaders/Library/TA_ShaderTypes.hlsl",
      "role": "Shared surface, lighting input and lighting output structures",
      "includeGuard": "TA_SHADER_TYPES_INCLUDED",
      "dependencies": [],
      "publicSymbols": ["TA_SurfaceData", "TA_LightingInput", "TA_LightingBreakdown"]
    },
    {
      "id": "common",
      "file": "Assets/_TA/Shaders/Library/TA_Common.hlsl",
      "role": "Numeric policy, safe normalization and debug encoders",
      "includeGuard": "TA_COMMON_INCLUDED",
      "dependencies": [],
      "publicSymbols": ["TA_SanitizePerceptualRoughness", "TA_SafeNormalize", "TA_EncodeNormalWS"]
    },
    {
      "id": "brdf",
      "file": "Assets/_TA/Shaders/Library/TA_BRDF.hlsl",
      "role": "Fresnel, GGX distribution and correlated Smith visibility",
      "includeGuard": "TA_BRDF_INCLUDED",
      "dependencies": ["common"],
      "publicSymbols": ["TA_FresnelSchlick", "TA_DistributionGGX", "TA_VisibilitySmithGGXCorrelated"]
    },
    {
      "id": "lighting",
      "file": "Assets/_TA/Shaders/Library/TA_Lighting.hlsl",
      "role": "Direct and indirect lighting decomposition",
      "includeGuard": "TA_LIGHTING_INCLUDED",
      "dependencies": ["types", "common", "brdf"],
      "publicSymbols": ["TA_EvaluateLighting"]
    },
    {
      "id": "debugViews",
      "file": "Assets/_TA/Shaders/Library/TA_DebugViews.hlsl",
      "role": "Stable debug view identifiers and output selection",
      "includeGuard": "TA_DEBUG_VIEWS_INCLUDED",
      "dependencies": ["types", "common"],
      "publicSymbols": ["TA_SelectDebugView"]
    }
  ],
  "invariants": [
    "Every module has an include guard and contains no package include",
    "Every public symbol starts with TA_ and is declared once",
    "Aggregate includes modules in dependency order",
    "FinalLit equals DirectDiffuse plus DirectSpecular plus IndirectDiffuse"
  ]
}
